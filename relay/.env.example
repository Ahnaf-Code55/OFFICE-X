# Replace this with a DNS name that resolves to this relay host. This address
# is advertised in libp2p Identify; OFFICE-X clients still need the relay Peer ID.
OFFICEX_RELAY_ANNOUNCE_MULTIADDRS=/dns4/relay.example.com/tcp/443/wss

# The defaults below are suitable only as a small starting point. Tune against
# measured traffic and the memory/CPU limits configured in compose.yml.
OFFICEX_RELAY_MAX_CONNECTIONS=250
OFFICEX_RELAY_MAX_INBOUND_HOP_STREAMS=128
OFFICEX_RELAY_MAX_OUTBOUND_HOP_STREAMS=128
OFFICEX_RELAY_MAX_OUTBOUND_STOP_STREAMS=128
OFFICEX_RELAY_MAX_RESERVATIONS=1000
OFFICEX_RELAY_RESERVATION_TTL_MS=7200000
OFFICEX_RELAY_MAX_DURATION_MS=1800000
OFFICEX_RELAY_MAX_DATA_BYTES=67108864
